<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="2dp">

    <FrameLayout
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginTop="1dp"
        android:background="@drawable/avatar_circle">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_sparkle"
            app:tint="@color/accent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <LinearLayout
            android:id="@+id/taskRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/chip_small"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_sparkle"
                app:tint="@color/accent" />

            <TextView
                android:id="@+id/textTask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/text2"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textThinking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="#FFB49CFF"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Claude/ChatGPT style: assistant text is plain, full width, no bubble -->
        <TextView
            android:id="@+id/textMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text1"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.25"
            android:textIsSelectable="true"
            android:text="" />

        <TextView
            android:id="@+id/textNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/text3"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
