<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle"><corners android:radius="3dp"/><solid android:color="#FF1B2431"/></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle"><corners android:radius="3dp"/><gradient android:angle="0" android:startColor="#FF6EC1FF" android:endColor="#FF2F81C4"/></shape>
        </clip>
    </item>
</layer-list>
