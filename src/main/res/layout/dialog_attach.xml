<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/sheet_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/handle_bar"
        android:layout_marginBottom="13dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnCloseSheet"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:padding="9dp"
            app:tint="@color/text1"
            android:contentDescription="Close attachment picker" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Add attachment"
            android:textColor="@color/text1"
            android:textSize="17sp"
            android:textStyle="bold" />

        <View
            android:layout_width="42dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:id="@+id/optImage"
            android:layout_width="0dp"
            android:layout_height="116dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/attachment_option_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <FrameLayout
                android:id="@+id/optionIconPhoto"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/attachment_icon_photo"
                android:elevation="5dp"
                android:outlineSpotShadowColor="#667BE3A8">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_image"
                    app:tint="@color/pgreen" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Photo"
                android:textColor="@color/text1"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="up to 10 MB"
                android:textColor="@color/text3"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/optZip"
            android:layout_width="0dp"
            android:layout_height="116dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/attachment_option_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <FrameLayout
                android:id="@+id/optionIconZip"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/attachment_icon_zip"
                android:elevation="5dp"
                android:outlineSpotShadowColor="#66FFB37B">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_zip"
                    app:tint="@color/porange" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ZIP"
                android:textColor="@color/text1"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="up to 25 MB"
                android:textColor="@color/text3"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/optFile"
            android:layout_width="0dp"
            android:layout_height="116dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/attachment_option_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <FrameLayout
                android:id="@+id/optionIconFile"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/attachment_icon_file"
                android:elevation="5dp"
                android:outlineSpotShadowColor="#66B49CFF">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_file"
                    app:tint="@color/ppurple" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="File"
                android:textColor="@color/text1"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="up to 25 MB"
                android:textColor="@color/text3"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Max 5 attachments · 50 MB total per message"
        android:textColor="@color/text3"
        android:textSize="11sp" />

</LinearLayout>
