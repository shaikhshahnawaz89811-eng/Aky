<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="102dp"
    android:layout_height="102dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/attachment_preview_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/previewImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/fileInfo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/textAttachType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/attachment_badge"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="ZIP"
            android:textColor="@color/porange"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />

        <TextView
            android:id="@+id/textAttachName"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:breakStrategy="simple"
            android:text="project-source.zip"
            android:textColor="@color/text1"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/textAttachSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="141 KB"
            android:textColor="@color/text3"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnRemoveAttach"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:background="@drawable/remove_attach_bg"
        android:src="@drawable/ic_close"
        android:padding="6dp"
        android:elevation="2dp"
        android:contentDescription="Remove attachment" />
</FrameLayout>